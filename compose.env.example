# Compose-level overrides for docker-compose.dev.yml and docker-compose.prod.yml

# Public host Caddy should respond to
HOSTNAME=localhost

# Cobalt image and env file path
COBALT_IMAGE=vatusa/cobalt:latest
COBALT_ENV_FILE=cobalt.env

# App env file paths
STAFF_ENV_FILE=apps/staff/.env
VATUSA_ENV_FILE=apps/vatusa/.env

# Shared/override secrets
COOKIE_SECRET=change_me_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
STAFF_COOKIE_SECRET=
VATUSA_COOKIE_SECRET=

# Database defaults used by compose
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=cobalt

