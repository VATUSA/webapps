# --- VCS / editor ---
.git
.git/*
**/.DS_Store
.idea
.vscode

# --- Dependencies / package manager caches ---
**/node_modules
**/.pnpm-store
**/.npm
**/.yarn
**/.yarn-cache

# --- Build outputs / caches ---
**/.next
**/.turbo
**/dist
**/build
